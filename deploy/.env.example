# Copy to /data/apps/smart-ops-dashboard/.env ON THE SERVER. Never commit the real file.
# Nothing here is a secret today; keep it that way (VITE_* values are public and are not set here).

# Host port the dashboard is published on (the container listens on 8080).
# 8180 is only a suggestion. Verify it is free before using it:
#   ss -ltn | grep -E ':8180\b' || echo "8180 free"
DASHBOARD_PORT=8180

# Smart_Ops_Pod1 FastAPI (agent 1, Viva Agent) base URL as seen from inside the container. No
# trailing slash. Port must match POD1_BACKEND_PORT set in the Pod1 repo's own deploy (see its
# deploy/.env.example) - coordinate the port with whoever deploys that pod.
AGENT1_API_URL=http://host.docker.internal:8011

# Smart_Ops_Pod3 FastAPI base URL as seen from inside the container. No trailing slash.
# Example when the backend is published on the VM host port 8000:
AGENT3_API_URL=http://host.docker.internal:8000

# Pod 2 backend (agent 2, Bias Flagging) base URL as seen from inside the container. No trailing slash.
# Use the host and port the Pod 2 API is published on, for example:
#   AGENT2_API_URL=http://<pod2-host>:<port>
# Until it is set, agent 2 requests get a 502 from nginx.
AGENT2_API_URL=http://host.docker.internal:8001
