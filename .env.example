# Copy to .env.local and adjust. All VITE_* values are public (bundled into the browser).

# Agent 3 (Stakeholder Roleplay).
#   true  = run on in-browser mock data, no backend needed (works out of the box)
#   false = talk to the real Smart_Ops_Pod3 API (start it first: docs/agent3-api-and-mocks.md)
VITE_USE_MOCKS=true

# Smart_Ops_Pod3 FastAPI base URL. Used by the Vite dev proxy (/agent3-api -> this URL).
VITE_AGENT3_API_URL=http://localhost:8000

# Sign-in.
#   unset or true = development login page (name + role), as before
#   false         = no login page; signs in a local user. VITE_DEV_ROLE=admin for the admin role
#                   (default trainee). Restart npm run dev after changing these.
VITE_AUTH_ENABLED=true
VITE_DEV_ROLE=trainee
